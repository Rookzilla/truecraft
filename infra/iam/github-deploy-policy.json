{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseTruecraftBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::123456789012:role/cdk-truecraft-deploy-role-123456789012-eu-west-2",
        "arn:aws:iam::123456789012:role/cdk-truecraft-file-publishing-role-123456789012-eu-west-2",
        "arn:aws:iam::123456789012:role/cdk-truecraft-image-publishing-role-123456789012-eu-west-2",
        "arn:aws:iam::123456789012:role/cdk-truecraft-lookup-role-123456789012-eu-west-2"
      ]
    },
    {
      "Sid": "ReadTruecraftBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-west-2:123456789012:parameter/cdk-bootstrap/truecraft/version"
    },
    {
      "Sid": "InspectTruecraftStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:eu-west-2:123456789012:stack/TruecraftStaticSite/*"
    },
    {
      "Sid": "ListTruecraftSiteBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::truecraft-static-site-123456789012-eu-west-2"
    },
    {
      "Sid": "PublishTruecraftSite",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::truecraft-static-site-123456789012-eu-west-2/*"
    },
    {
      "Sid": "InvalidateTruecraftDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::123456789012:distribution/DISTRIBUTION_ID"
    }
  ]
}
